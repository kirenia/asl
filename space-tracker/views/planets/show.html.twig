{% extends "layout.html.twig" %}
{% block title %}{{ planet.name }}{% endblock %}
{% block content %}
  <p><a href="/planets">&larr; All planets</a></p>
  <article class="detail">
    {% if image %}<img src="{{ image }}" alt="{{ planet.name }}">{% endif %}
    <div>
      <h1>{{ planet.name }}</h1>
      <p><strong>Size:</strong> {{ planet.size }}</p>
      <p>{{ planet.description }}</p>
      {% if planet.Stars|length %}<h2>Orbits</h2><ul>{% for s in planet.Stars %}<li><a href="/stars/{{ s.id }}">{{ s.name }}</a></li>{% endfor %}</ul>{% endif %}
    </div>
  </article>
  <div class="actions">
    <a class="button" href="/planets/{{ planet.id }}/edit">Edit</a>
    <form method="post" action="/planets/{{ planet.id }}/delete">
      <button class="danger" type="submit">Delete</button>
    </form>
  </div>
{% endblock %}
