{% extends "layout.html.twig" %}
{% block title %}{{ galaxy.id ? 'Edit ' ~ galaxy.name : 'New Galaxy' }}{% endblock %}
{% block content %}
  <h1>{{ galaxy.id ? 'Edit ' ~ galaxy.name : 'New Galaxy' }}</h1>
  <form class="form" method="post" enctype="multipart/form-data" action="{{ galaxy.id ? '/galaxies/' ~ galaxy.id : '/galaxies' }}">
    <label>Name <input name="name" required value="{{ galaxy.name }}"></label>
    <label>Size <input name="size" type="number" required value="{{ galaxy.size }}"></label>
    <label>Description <textarea name="description" rows="4">{{ galaxy.description }}</textarea></label>

    <label>Image <input name="image" type="file" accept="image/*"></label>
    <button type="submit">Save</button>
  </form>
{% endblock %}
